{
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds
  // refuses to deploy otherwise).
  "name": "portmaster-wiki",
  "compatibility_date": "2026-11-01",
  // Runs before every `wrangler deploy` / `versions upload`, so Workers Builds
  // regenerates the site (and re-downloads the port data) itself. Same
  // packages as .github/workflows/ci.yml, plus pillow for the home page mosaic.
  "build": {
    "command": "python3 -m pip install mkdocs-material mkdocs-glightbox mkdocs-macros-plugin pillow && python3 -m mkdocs build"
  },
  // `mkdocs build` writes the finished site into site/; that's what gets served.
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cron that pings the Workers Builds deploy hook: every hour, plus shortly
  // after a new PortMaster-New / PortMaster-MV-New release. See
  // worker/scheduled.js (INTERVAL_MIN there must match this schedule).
  "main": "worker/scheduled.js",
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
